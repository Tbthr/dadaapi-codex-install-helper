{
  "name": "dadaapi-assistant-workspace",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": "https://github.com/Tbthr/dadaapi-codex-install-helper",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --dir apps/desktop tauri dev",
    "build": "pnpm --dir apps/desktop tauri build",
    "build:frontend": "pnpm --dir apps/desktop build",
    "check:frontend": "pnpm --dir apps/desktop check",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format:check": "cargo fmt --all -- --check && pnpm --dir apps/desktop format:check",
    "verify": "pnpm format:check && pnpm check:frontend && pnpm check:rust && pnpm test:rust && pnpm lint:rust",
    "tauri:info": "pnpm --dir apps/desktop tauri info"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.17",
      "brace-expansion@2.1.2": "2.1.3",
      "brace-expansion@5.0.7": "5.0.8",
      "postcss@8.5.16": "8.5.18"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
